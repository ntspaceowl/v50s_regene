+    private boolean mPhysicalControllerConnected;
+    private final InputManager.InputDeviceListener mControllerListener = new InputManager.InputDeviceListener() {
+        public void onInputDeviceAdded(int id) { updateControllerVisibility(); }
+        public void onInputDeviceRemoved(int id) { updateControllerVisibility(); }
+        public void onInputDeviceChanged(int id) { updateControllerVisibility(); }
+    };
+
+    private boolean hasPhysicalController() {
+        for (int id : InputDevice.getDeviceIds()) {
+            InputDevice device = InputDevice.getDevice(id);
+            if (device != null && device.isEnabled() && device.isExternal() && !device.isVirtual()
+                    && (device.supportsSource(InputDevice.SOURCE_GAMEPAD)
+                    || device.supportsSource(InputDevice.SOURCE_JOYSTICK))) return true;
+        }
+        return false;
+    }
+
+    private void updateControllerVisibility() {
+        boolean connected = hasPhysicalController();
+        if (connected == mPhysicalControllerConnected) return;
+        if (connected) {
+            for (InputObject input : mInputObjects) {
+                if (input.getPointerId() != -1) {
+                    input.onPointerUp(input.getPointerId(), 0, 0);
+                }
+            }
+        }
+        mPhysicalControllerConnected = connected;
+        refreshControls();
+        invalidate();
+    }
+
+    @Override protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        InputManager manager = (InputManager) getContext().getSystemService(Context.INPUT_SERVICE);
+        manager.registerInputDeviceListener(mControllerListener, new Handler(Looper.getMainLooper()));
+        updateControllerVisibility();
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        InputManager manager = (InputManager) getContext().getSystemService(Context.INPUT_SERVICE);
+        manager.unregisterInputDeviceListener(mControllerListener);
+        super.onDetachedFromWindow();
+    }
 
